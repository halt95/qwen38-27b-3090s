diff --git a/v1/qwen35_series.py b/v1/qwen35_series.py
new file mode 100644
index 0000000000..141292c67d
--- /dev/null
+++ b/v1/qwen35_series.py
@@ -0,0 +1,26 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Family gate for the Qwen3.8-27B series patches (dense Qwen3.5 on sm_86).
+
+The 27B patches (uniform multi-token FlashInfer decode, the decode-plan cache, the
+MTP draft seq_lens no-sync and the GDN in_proj_ba split-K) were validated only for
+the dense Qwen3.5 architectures on Ampere sm_86. On the shared engine every other
+family (Flash-Next = Qwen4Exp included) and every other device must take the stock
+path, so each patch asks this one predicate and fails closed.
+"""
+
+DENSE_QWEN35_ARCHS = ("Qwen3_5ForCausalLM", "Qwen3_5ForConditionalGeneration")
+
+
+def is_dense_qwen35(architecture: str | None) -> bool:
+    return architecture in DENSE_QWEN35_ARCHS
+
+
+def series_active(vllm_config) -> bool:
+    """True only for a dense Qwen3.5 target on an sm_86 device."""
+    model_config = getattr(vllm_config, "model_config", None)
+    if model_config is None or not is_dense_qwen35(model_config.architecture):
+        return False
+    from vllm.platforms import current_platform
+
+    cap = current_platform.get_device_capability()
+    return cap is not None and cap.to_int() == 86
