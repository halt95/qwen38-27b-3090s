         query_key_settings = (self.key_dim, 0, False)
         value_settings = (self.value_dim, 0, False)
@@ -910,7 +913,16 @@ class QwenGatedDeltaNetAttention(GatedDeltaNetAttention):
         # Part 1: Input Projection
         # ============================================================
         mixed_qkvz, _ = self.in_proj_qkvz(hidden_states)
-        ba, _ = self.in_proj_ba(hidden_states)
+        # --- GDN in_proj_ba split-K (sm_86, small M): VLLM_GDN_BA_SPLITK ---
+        # Unquantized, bias-free projection only; the op dispatches on M itself.
+        if (
+            self.use_ba_splitk
+            and type(self.in_proj_ba.quant_method).__name__ == "UnquantizedLinearMethod"
+            and self.in_proj_ba.bias is None
+        ):
+            ba = torch.ops.vllm.gdn_ba_splitk(hidden_states, self.in_proj_ba.weight)
+        else:
+            ba, _ = self.in_proj_ba(hidden_states)
 
         use_fused_gdn_decode = (
             self.enable_fused_gdn_decode
